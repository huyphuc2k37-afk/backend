// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ───────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?   // hashed, null for Google OAuth users
  image         String?
  role          String    @default("reader") // reader | author | moderator | admin
  isSuperMod    Boolean   @default(false) // only admin-designated mods can edit stories
  provider      String    @default("google") // google | email
  emailVerified Boolean   @default(false)
  bio           String?   @db.Text
  readingPreferences String? // JSON: {fontFamily, fontSize, lineHeight, theme}
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stories       Story[]
  bookmarks     Bookmark[]
  readHistory   ReadHistory[]
  comments      Comment[]
  deposits      Deposit[]
  purchases     ChapterPurchase[]
  withdrawals   Withdrawal[]
  notifications Notification[]
  followers     Follow[]  @relation("Following") // người theo dõi mình
  following     Follow[]  @relation("Follower")  // mình theo dõi ai
  coinBalance   Int       @default(0) // xu hiện tại
  storyLikes    StoryLike[]
  ratings       Rating[]
  commentLikes  CommentLike[]
  earnings      AuthorEarning[]
  announcements Announcement[] @relation("AnnouncementCreator")
  sentMessages     Message[]      @relation("MessageSender")
  conversations    ConversationParticipant[]
  sentGifts        GiftTransaction[] @relation("GiftSender")
  receivedGifts    GiftTransaction[] @relation("GiftReceiver")
  paidSuggestions  PaidSuggestion[]

  // ── Referral (Mã mời tác giả) ──
  referralCode  String?   @unique // mã mời duy nhất, chỉ tác giả mới có
  referredById  String?   // ID tác giả đã giới thiệu user này
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]    @relation("Referrals") // những user mà mình giới thiệu
  referralEarnings ReferralEarning[]
  dailyQuests   DailyQuest[]

  // ── Relations for new models ──
  authorBadges       AuthorBadge[]
  fanClubMember      FanClubMember[]
  fanClub            FanClub?
  fanClubActivities  FanClubActivity[]
  affiliateEarnings  AffiliateEarning[] @relation("EarningUser")
  affiliateReferrals AffiliateEarning[] @relation("EarningReferral")
  affiliateLinks     AffiliateLink[] @relation("AffiliateLinkOwner")

  @@index([role])
  @@index([referredById])
}

// ─── Deposits (Nạp xu) ──────────────────────────
model Deposit {
  id            String    @id @default(cuid())
  amount        Int       // VNĐ
  coins         Int       // xu nhận được (bao gồm bonus)
  method        String    // "zalopay" | "agribank"
  status        String    @default("pending") // pending | approved | rejected
  transferCode  String    @unique // mã giao dịch duy nhất (VD: VS-AB12CD)
  transferNote  String?   // nội dung chuyển khoản
  proofImage    String?   // ảnh minh chứng
  adminNote     String?   // ghi chú từ admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── Chapter Purchases (Mua chương) ─────────────
model ChapterPurchase {
  id            String    @id @default(cuid())
  coins         Int       // xu đã trả
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId])
}

// ─── Withdrawals (Rút tiền tác giả) ─────────────
model Withdrawal {
  id              String    @id @default(cuid())
  amount          Int       // xu muốn rút
  moneyAmount     Int       // VNĐ tương ứng
  bankName        String
  bankAccount     String
  bankHolder      String
  status          String    @default("pending") // pending | approved | rejected
  adminNote       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── Categories (Danh mục chính) ─────────────────
model Category {
  id              String    @id @default(cuid())
  name            String    // Tên hiển thị: "Tình cảm", "Huyền huyễn & Giả tưởng"
  slug            String    @unique // URL slug: "tinh-cam"
  description     String?   @db.Text
  seoTitle        String?   // SEO title cho trang thể loại
  seoDescription  String?   // SEO meta description
  icon            String?   // Icon name cho frontend
  color           String?   // Color hex cho frontend
  displayOrder    Int       @default(0) // Thứ tự hiển thị
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stories         Story[]

  @@index([displayOrder])
}

// ─── Tags (Thẻ tag) ──────────────────────────────
model Tag {
  id              String    @id @default(cuid())
  name            String    // Tên hiển thị: "Ngôn tình", "1x1"
  slug            String    @unique // URL slug: "ngon-tinh"
  type            String    @default("genre") // genre | setting | tone | relation | ending | perspective | content | form
  createdAt       DateTime  @default(now())

  storyTags       StoryTag[]

  @@index([type])
}

// ─── Story Tags (junction) ───────────────────────
model StoryTag {
  id              String    @id @default(cuid())

  storyId         String
  story           Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tagId           String
  tag             Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([storyId, tagId])
  @@index([tagId])
}

// ─── Redirects (301 cho URL cũ) ──────────────────
model Redirect {
  id              String    @id @default(cuid())
  oldPath         String    @unique // /the-loai/ngon-tinh
  newPath         String    // /the-loai/tinh-cam
  code            Int       @default(301) // HTTP status code
  createdAt       DateTime  @default(now())
}

// ─── Stories ─────────────────────────────────────
model Story {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String    @db.Text
  coverImage      String?
  featuredSlot    Int?      @unique
  genre           String    // legacy: Tiên hiệp, Kiếm hiệp, etc. (kept for backward compat)
  status          String    @default("ongoing") // ongoing | completed | paused
  approvalStatus  String    @default("pending") // pending | approved | rejected
  rejectionReason String?   // lý do từ chối (nếu rejected)
  reviewedBy      String?   // ID moderator đã duyệt
  reviewedAt      DateTime? // thời gian duyệt
  coverApprovalStatus String @default("pending") // pending | approved | rejected
  coverRejectionReason String? // lý do từ chối ảnh bìa
  tags            String?   // legacy: comma-separated (migrated to StoryTag)
  storyOrigin     String    @default("original") // original | translated
  originalTitle   String?
  originalAuthor  String?
  originalLanguage String?
  translatorName  String?
  translationGroup String?
  sourceName      String?
  sourceUrl       String?
  views           Int       @default(0)
  lastSettledViews Int      @default(0) // views already paid to author (for view-earnings settlement)
  likes           Int       @default(0)
  averageRating   Float     @default(0)
  ratingCount     Int       @default(0)
  // B6: Boost score from paid suggestions. Higher = ranks higher on homepage.
  // Decays over time in recommendation engine.
  boostScore      Int       @default(0)
  boostedAt       DateTime? // last time boostScore was incremented (for decay)

  // ── Category (new) ──
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])

  // ── Đề cương (Outline) ──
  theme           String?   // chủ đề
  expectedChapters Int?     // số chương dự kiến
  worldBuilding   String?   @db.Text // thiết lập thế giới
  characters      String?   @db.Text // JSON: [{name, role, description}]
  plotOutline     String?   @db.Text // JSON: [{order, title, summary}]

  // ── Cài đặt ──
  targetAudience  String?   // "13-17" | "18-25" | "25+"
  postSchedule    String?   // comma-separated days: "mon,wed,fri"
  isAdult         Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  chapters        Chapter[]
  bookmarks       Bookmark[]
  readHistory     ReadHistory[]
  comments        Comment[]
  storyLikes      StoryLike[]
  ratings         Rating[]
  storyTags       StoryTag[]
  paidSuggestions PaidSuggestion[]
  giftTransactions GiftTransaction[]

  @@index([authorId])
  @@index([views])
  @@index([likes])
  @@index([genre])
  @@index([storyOrigin])
  @@index([featuredSlot])
  @@index([categoryId])
  @@index([updatedAt])
  @@index([status])
  @@index([approvalStatus])
}

// ─── Chapters ────────────────────────────────────
model Chapter {
  id              String    @id @default(cuid())
  title           String
  number          Int
  content         String    @db.Text // full text content
  wordCount       Int       @default(0)
  isLocked        Boolean   @default(false)
  price           Int       @default(0)     // VNĐ, 0 = free
  authorNote      String?   @db.Text // ghi chú tác giả cuối chương
  approvalStatus  String    @default("pending") // pending | approved | rejected
  rejectionReason String?
  reviewedBy      String?   // ID moderator
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  storyId       String
  story         Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  readHistory   ReadHistory[]
  purchases     ChapterPurchase[]
  comments      Comment[]

  @@unique([storyId, number])
  @@index([approvalStatus])
}

// ─── Bookmarks (Tủ truyện) ──────────────────────
model Bookmark {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId       String
  story         Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
}

// ─── Reading History ────────────────────────────
model ReadHistory {
  id            String    @id @default(cuid())
  lastReadAt    DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId       String
  story         Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

// ─── Comments ───────────────────────────────────
model Comment {
  id            String    @id @default(cuid())
  content       String    @db.Text
  likes         Int       @default(0)
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId       String
  story         Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapterId     String?
  chapter       Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // Inline paragraph commenting (null = regular chapter/story comment)
  paragraphIndex Int?     // 0-based index of the paragraph within the chapter

  // Reply threading
  parentId      String?
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  commentLikes  CommentLike[]

  @@index([storyId, createdAt])
  @@index([chapterId, createdAt])
  @@index([chapterId, paragraphIndex])
  @@index([parentId])
}

// ─── Comment Likes (Thích bình luận) ─────────────
model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

// ─── Notifications (Thông báo) ──────────────────
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   @default("system") // system | wallet | admin
  link      String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

// ─── Follows (Theo dõi tác giả) ─────────────────
model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  followerId  String   // người theo dõi
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   // tác giả được theo dõi
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─── Story Likes (Thích truyện) ──────────────────
model StoryLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

// ─── Ratings (Đánh giá truyện) ───────────────────
model Rating {
  id        String   @id @default(cuid())
  score     Int      // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

// ─── Author Earnings (Doanh thu tác giả) ─────────
model AuthorEarning {
  id           String   @id @default(cuid())
  type         String   // "purchase" | "tip" | "view" | "admin"
  amount       Int      // xu tác giả nhận được
  viewCount    Int?     // số view tạo ra earning này (chỉ áp dụng cho type="view")
  createdAt    DateTime @default(now())

  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromUserId   String?  // người mua / tặng
  chapterId    String?  // chương liên quan
  storyId      String?  // truyện liên quan
  storyTitle   String?  // cache tên truyện
  chapterTitle String?  // cache tên chương

  @@index([authorId, createdAt])
  @@index([authorId, type])
  @@index([storyId])
  @@index([chapterId])
}

// ─── Platform Earnings (Doanh thu nền tảng) ─────
model PlatformEarning {
  id            String   @id @default(cuid())
  type          String   // "purchase" | "tip" | "gift"
  grossAmount   Int      // tổng xu user đã chi
  authorAmount  Int      // xu trả cho tác giả (net)
  platformAmount Int     // phần nền tảng (thực tế)
  taxAmount     Int      // thuế
  createdAt     DateTime @default(now())

  authorId      String?
  fromUserId    String?
  chapterId     String?
  storyId       String?
  storyTitle    String?
  chapterTitle  String?

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([authorId, createdAt])
  @@index([storyId])
}

// ─── Referral Earnings (Hoa hồng giới thiệu) ────
model ReferralEarning {
  id              String   @id @default(cuid())
  type            String   // "deposit_commission" | "author_income_commission"
  amount          Int      // xu hoa hồng nhận được
  sourceAmount    Int      // xu gốc (deposit amount hoặc author income)
  rate            Float    // tỉ lệ hoa hồng (0.02 hoặc 0.01)
  createdAt       DateTime @default(now())

  referrerId      String   // tác giả nhận hoa hồng
  referrer        User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  fromUserId      String?  // user được giới thiệu (người nạp xu hoặc tác giả có thu nhập)
  depositId       String?  // deposit liên quan (nếu deposit_commission)
  storyId         String?  // truyện liên quan (nếu author_income_commission)
  storyTitle      String?
  chapterId       String?
  chapterTitle    String?

  @@index([referrerId, createdAt])
  @@index([referrerId, type])
  @@index([fromUserId])
}

// ─── Announcements (marquee banner) ──────────────
model Announcement {
  id        String   @id @default(cuid())
  message   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   String
  createdByUser User @relation("AnnouncementCreator", fields: [createdBy], references: [id])
}

// ─── Conversations (Hội thoại Admin/Mod ↔ Tác giả) ──
model Conversation {
  id        String   @id @default(cuid())
  subject   String?  // tiêu đề (VD: "Về truyện XYZ")
  storyId   String?  // liên kết đến truyện (nếu có)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
  @@index([storyId])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  content        String   @db.Text
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── View Log (Batch view tracking) ──────────────
model ViewLog {
  id        String   @id @default(cuid())
  storyId   String
  ip        String
  userId    String?  // populated when logged in (more reliable dedup than IP)
  userAgent String?  // populated for bot filtering audit
  fingerprintId String? // link to DeviceFingerprint
  qualityScore   Float?  @default(0) // 0-1 score combining dwell/scroll/etc.
  dwellTime      Int     @default(0) // seconds
  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([createdAt])
  @@index([ip, storyId, createdAt]) // dedup: 1 view per IP per story per hour
  @@index([ip, createdAt])          // daily cap check
  @@index([userId, storyId, createdAt]) // dedup: 1 view per user per story per hour
}

// ─── Banned IPs (Anti-spam) ──────────────────────
model BannedIP {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?  // lý do ban
  bannedBy  String?  // admin email
  createdAt DateTime @default(now())

  @@index([ip])
}

// ─── Banned Emails (Anti-spam) ───────────────────
model BannedEmail {
  id        String   @id @default(cuid())
  email     String   @unique  // normalized email
  reason    String?  // lý do ban
  bannedBy  String?  // admin email
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Daily Quests (Nhiệm vụ hàng ngày) ──────────
model DailyQuest {
  id              String   @id @default(cuid())
  userId          String
  date            String   // YYYY-MM-DD format for easy grouping
  checkin         Boolean  @default(false) // Nhiệm vụ 1: Điểm danh
  commented       Boolean  @default(false) // Nhiệm vụ 2: Bình luận 1 chương
  readMinutes     Int      @default(0)     // Phút đọc tích lũy trong ngày
  readCompleted   Boolean  @default(false) // Nhiệm vụ 3: Đọc >= 10 phút
  adsWatched      Int      @default(0)     // Nhiệm vụ 4: Số quảng cáo đã xem (tối đa 5)
  coinsEarned     Int      @default(0)     // Tổng xu đã nhận từ nhiệm vụ ngày đó
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ─── Ad Placements (Vị trí quảng cáo) ────────────
model AdPlacement {
  id              String   @id @default(cuid())
  location        String   @unique // banner_top | banner_sidebar | banner_footer | in_content | reward_video
  adNetwork       String   @default("google")
  adUnitId        String?
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  // B7: custom banner (shop thủ công) fields
  customImageUrl  String?  // URL ảnh banner
  customVideoUrl  String?  // URL video banner (optional)
  clickUrl        String?  // URL khi click banner → shop
  advertiserName  String?  // Tên shop / nhà quảng cáo
  advertiserPhone String?  // SĐT liên hệ
  monthlyPrice    Int?     // Giá/tháng (VND), 500000 = 500k
  startDate       DateTime? // Ngày bắt đầu hiển thị
  endDate         DateTime? // Ngày kết thúc
  paidUntil       DateTime? // Đã thanh toán đến ngày này
  status          String   @default("network") // network | custom | expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Ad Impressions (Lượt xem quảng cáo) ──────────
model AdImpression {
  id              String   @id @default(cuid())
  userId          String?
  storyId         String?
  chapterId       String?
  placement       String   // banner_top | banner_sidebar | banner_footer | in_content | reward_video
  adNetwork       String   @default("google")
  adUnitId        String?
  impressionTime  DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([storyId])
  @@index([createdAt])
  @@index([placement])
}

// ─── Ad Analytics (Thống kê quảng cáo) ────────────
model AdAnalytics {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD format
  placement       String
  impressions     Int      @default(0)
  rewardsClaimed  Int      @default(0)
  coinsDistributed Int     @default(0)
  uniqueUsers     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, placement])
  @@index([date])
  @@index([placement])
}

// ─── Ad Rewards (Phần thưởng quảng cáo) ───────────
model AdReward {
  id        String   @id @default(cuid())
  userId    String
  coins     Int      // Số xu nhận được
  watchedAt DateTime @default(now())

  @@index([userId])
  @@index([userId, watchedAt])
}

// ─── Device Fingerprints (Dấu vân tay thiết bị) ───
model DeviceFingerprint {
  id            String   @id @default(cuid())
  hash          String   @unique // SHA256 fingerprint hash
  ipAddresses   String[] // Danh sách IP đã sử dụng (giữ tối đa 50)
  viewCount     Int      @default(1)
  isBot         Boolean  @default(false)
  botScore      Int      @default(0)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hash])
  @@index([ipAddresses])
}

// ─── User Reading Profiles (Hồ sơ đọc của user) ────
model UserReadingProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  favoriteGenres   String[]  // Thể loại yêu thích
  preferredOrigin  String[]  // original | translated
  avgReadLength    Int       @default(0) // Độ dài trung bình chương đọc
  lastUpdated      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

// ─── Recommendation Logs (Nhật ký đề xuất) ───────
model RecommendationLog {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  reason    String   // similar | popular | new | genre | author | collaborative | trending
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([storyId])
  @@index([createdAt])
}

// ─── Author Badges (Huy hiệu tác giả) ─────────────
model AuthorBadge {
  id        String    @id @default(cuid())
  authorId  String
  badgeType String    // top_author | trending | verified | rising_star | prolific | legendary | vip | contest_winner | community_hero
  earnedAt  DateTime  @default(now())
  expiresAt DateTime? // null = vĩnh viễn
  createdAt DateTime  @default(now())

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, badgeType, expiresAt])
  @@index([authorId])
  @@index([badgeType])
}

// ─── Author Levels (Cấp bậc tác giả) ──────────────
model AuthorLevel {
  id          String @id @default(cuid())
  level       Int    @unique
  name        String // Bronze | Silver | Gold | Platinum | Diamond
  minViews    Int    @default(0)
  minStories  Int    @default(0)
  minEarnings Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Affiliate Links (Liên kết_affiliate) ──────────
model AffiliateLink {
  id              String   @id @default(cuid())
  userId          String   // Người tạo link
  code            String   @unique
  destination     String   // story | author | campaign | page
  targetId        String?  // ID của story/author/target
  targetTitle     String?  // Cache tên
  clickCount      Int      @default(0)
  conversionCount Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation("AffiliateLinkOwner", fields: [userId], references: [id], onDelete: Cascade)
  earnings        AffiliateEarning[]

  @@index([userId])
  @@index([code])
  @@index([destination])
}

// ─── Affiliate Clicks (Click_affiliate) ────────────
model AffiliateClick {
  id        String   @id @default(cuid())
  linkId    String
  userId    String?
  ip        String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Affiliate Earnings (Thu nhập affiliate) ──────
model AffiliateEarning {
  id              String   @id @default(cuid())
  userId          String   // Người nhận hoa hồng
  referralUserId  String?  // User được giới thiệu
  linkId          String?
  action          String   // signup | first_purchase | view_milestone | referral_read
  commission      Int      // Số xu hoa hồng
  description     String?
  createdAt       DateTime @default(now())

  user            User?    @relation("EarningUser", fields: [userId], references: [id], onDelete: Cascade)
  referralUser    User?    @relation("EarningReferral", fields: [referralUserId], references: [id], onDelete: SetNull)
  link            AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([referralUserId])
  @@index([createdAt])
}

// ─── Fan Clubs (Fan club tác giả) ─────────────────
model FanClub {
  id            String   @id @default(cuid())
  authorId      String   @unique
  name          String
  description   String?
  totalFans     Int      @default(0)
  totalCoins    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  members       FanClubMember[]
  activities    FanClubActivity[]

  @@index([authorId])
}

// ─── Fan Club Members (Thành viên fan club) ────────
model FanClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  tier      String   @default("member") // member | vip | svip
  tierCoins Int      @default(0)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  club      FanClub  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

// ─── Fan Club Activities (Hoạt động fan club) ──────
model FanClubActivity {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  action    String   // joined | donated | upgraded
  coins     Int      @default(0)
  createdAt DateTime @default(now())

  club      FanClub  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Gift Types (Loại quà tặng) ───────────────────
model GiftType {
  id            String   @id @default(cuid())
  name          String
  emoji         String   // Emoji hiển thị
  price         Int      // Giá bằng xu
  animationUrl  String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  GiftTransaction[]
}

// ─── Gift Transactions (Giao dịch quà tặng) ────────
model GiftTransaction {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  storyId     String?
  giftTypeId  String
  quantity    Int
  totalCoins  Int
  message     String?
  createdAt   DateTime @default(now())

  sender      User     @relation("GiftSender", fields: [senderId], references: [id])
  receiver    User     @relation("GiftReceiver", fields: [receiverId], references: [id])
  giftType    GiftType @relation(fields: [giftTypeId], references: [id])
  story       Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([storyId])
  @@index([giftTypeId])
  @@index([createdAt])
}

// ─── Paid Suggestions (Đề xuất trả phí) ────────────
model PaidSuggestion {
  id          String    @id @default(cuid())
  userId      String
  storyId     String
  message     String?
  coinsSpent  Int
  status      String    @default("pending") // pending | approved | rejected | cancelled | spam
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  story       Story     @relation(fields: [storyId], references: [id])

  @@index([userId])
  @@index([storyId])
  @@index([status])
  @@index([createdAt])
}

// ─── Suggestion Pool (Hồ bơi đề xuất) ─────────────
model SuggestionPool {
  id      String   @id @default(cuid())
  date    DateTime @unique // Ngày YYYY-MM-DD
  slots   Int      @default(5)
  stories String[] // Array of story IDs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ─── View Sessions (Phiên đọc) ────────────────────
model ViewSession {
  id            String   @id @default(cuid())
  storyId       String
  userId        String?
  qualityScore  Float    @default(0)
  dwellTime     Int      @default(0) // seconds
  scrollDepth   Float    @default(0) // 0-1
  chaptersRead  Int      @default(0)
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  @@index([storyId])
  @@index([userId])
  @@index([startedAt])
  @@index([qualityScore])
}

// ─── Realtime View Stats (Thống kê view realtime) ─
model RealtimeViewStats {
  id          String   @id @default("global") // Chỉ có 1 record, luôn dùng id="global"
  todayViews  Int      @default(0)
  weekViews   Int      @default(0)
  monthViews  Int      @default(0)
  activeNow   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ─── Monthly View Stats (Thống kê view theo tháng) ─
model MonthlyViewStats {
  id        String   @id @default(cuid())
  storyId   String
  yearMonth String   // YYYY-MM format
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, yearMonth])
  @@index([storyId])
  @@index([yearMonth])
}

// ─── Author Ad Config (Cấu hình quảng cáo tác giả) ────────────
model AuthorAdConfig {
  id                 String   @id @default(cuid())
  authorId          String   @unique
  enabled           Boolean  @default(true)
  adFrequency       Int      @default(5) // Hiển thị quảng cáo mỗi N chương
  revenueShare      Float    @default(0.7) // Tỉ lệ tác giả nhận (70%)
  totalEarnings     Int      @default(0) // Tổng xu kiếm được
  pendingWithdrawal Int      @default(0) // Xu đang chờ rút
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([authorId])
}

// ─── Author Ad Earnings (Thu nhập quảng cáo tác giả) ────────
model AuthorAdEarning {
  id            String   @id @default(cuid())
  authorId      String
  storyId       String
  chapterId     String
  chapterNumber Int
  impressions   Int      @default(0)
  earnings      Int      @default(0) // xu tác giả nhận
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([authorId, storyId, chapterId])
  @@index([authorId, createdAt])
  @@index([storyId])
}

// ─── Author Ad Logs (Nhật ký hiển thị quảng cáo) ───────────
model AuthorAdLog {
  id        String   @id @default(cuid())
  authorId  String
  storyId   String
  chapterId String
  adShown   Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  @@index([authorId])
  @@index([storyId])
  @@index([createdAt])
}

// ─── Quest Progress (Tiến độ nhiệm vụ) ────────────
model QuestProgress {
  id            String   @id @default(cuid())
  userId        String
  questId       String   // ID của quest
  progress      Int      @default(0)
  completed     Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, questId])
  @@index([userId])
}
